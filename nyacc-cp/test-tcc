(define (try-file name)
  (let* ((file (string-append tcc-root "/" name)))
    (with-input-from-file file
      (lambda ()
        (parse-c99 
         #:cpp-defs cpp-defs
         #:inc-dirs inc-dirs
        #:debug #f)))))

(define (main . args)
  (for-each
   (lambda (file)
     (display file) (display ":\t") (force-output)
     (display (if (try-file file) "PASS" "FAIL")) (newline))
   tcc-cfiles))

